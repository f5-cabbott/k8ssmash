# /etc/default/k8ssmash: per-machine overrides for the booth service. Uncomment what you need.

# Audio: SDL's ALSA backend. Find your device with `aplay -L` (e.g. the HDMI output).
#SDL_AUDIODRIVER=alsa
#AUDIODEV=hdmi:CARD=vc4hdmi0,DEV=0

# If the display comes up at the wrong size, force a mode on the kernel command line instead
# (see deploy/README.md), or tell the game which size to assume when windowed.
#K8SSMASH_EXTRA_ARGS=--fps
